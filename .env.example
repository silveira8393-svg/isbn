# No public API keys required for BrasilAPI and Distribuidora Curitiba public consultation

# Official Amazon SP-API -- SERVER ONLY. Disabled until reviewed/configured.
# Never prefix any of these variables with VITE_. Never commit real values.
AMAZON_SPAPI_ENABLED=false
AMAZON_SPAPI_EXTERNAL_AUTH_APPROVED=false
AMAZON_SPAPI_ORIGIN=https://isbn.silveiralab.com.br
AMAZON_SPAPI_DRAFT=true
AMAZON_SPAPI_APP_ID=
AMAZON_SPAPI_CLIENT_ID=
AMAZON_SPAPI_CLIENT_SECRET=
# 32 random bytes encoded as 64 hex characters (AES-256-GCM key, v1).
AMAZON_SPAPI_TOKEN_KEY=
# Exactly one reviewed store/seller binding for this deployment.
AMAZON_SPAPI_STORE_ID=
AMAZON_SPAPI_SELLER_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
